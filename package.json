{
  "name": "kanban-board",
  "displayName": "Simple Kanban Board",
  "description": "Simple kanban board for TODO management.",
  "icon": "icon.png",
  "version": "1.0.10",
  "publisher": "te-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tete0123/Kanban-Board.git"
  },
  "bugs": {
    "url": "https://github.com/tete0123/Kanban-Board/issues"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kanban",
    "board",
    "agile",
    "project",
    "management",
    "sprint",
    "productivity",
    "scrum"
  ],
  "activationEvents": [
    "onCommand:kanban.openBoard"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kanban.openBoard",
        "title": "Kanban: Open Board"
      }
    ],
    "configuration": {
      "title": "Kanban Board",
      "properties": {
        "kanban.clear.exportBeforeDelete": {
          "type": "boolean",
          "default": false,
          "description": "Export all cards in a column to one Markdown file before clearing the column."
        },
        "kanban.clear.exportFolder": {
          "type": "string",
          "default": "",
          "description": "Folder for Markdown files exported before clearing a column. Use an absolute path or a path relative to the workspace root."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "tsc -p ./",
    "compile:webview": "tsc -p ./tsconfig.webview.json",
    "watch": "tsc -watch -p ./",
    "lint": "echo \"No lint configured\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.88.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
